<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DurableExecution.Core\DurableExecution.Core.csproj" />
    <ProjectReference Include="..\..\src\DurableExecution.SqlServer\DurableExecution.SqlServer.csproj" />
    <!-- Builds the scenario host executable; the tests drive it as a child
         process. It is not referenced as a library. -->
    <ProjectReference Include="..\DurableExecution.TestHost\DurableExecution.TestHost.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetPath>true</SkipGetTargetPath>
    </ProjectReference>
  </ItemGroup>

</Project>
