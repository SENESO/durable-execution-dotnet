<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The suite crafts sealed records directly to test corruption handling. -->
    <InternalsVisibleTo Include="DurableExecution.Tests" />
    <!-- Providers seal records with the same internal checksum the file
         provider uses; the seal is one implementation for every medium. -->
    <InternalsVisibleTo Include="DurableExecution.SqlServer" />
    <InternalsVisibleTo Include="DurableExecution.PostgreSql" />
    <InternalsVisibleTo Include="DurableExecution.Sqlite" />
  </ItemGroup>

</Project>
